# 可选。只有继续接入独立聚合音乐服务时才填写；内置网易云、QQ音乐和B站扫码不需要它。
VITE_MUSIC_ACCOUNT_API_BASE=https://music-account.example.com

# 音乐隐私说明中使用的部署者信息。公开上线前请如实填写。
VITE_MUSIC_OPERATOR_NAME=你的名称或运营主体
VITE_MUSIC_OPERATOR_CONTACT=你的联系邮箱
VITE_MUSIC_SESSION_RETENTION_DAYS=90
VITE_MUSIC_PRIVACY_URL=https://你的站点/音乐与隐私说明

# 可选。Netlify Function 中的平台登录 Cookie 有效天数，默认 90 天。
MUSIC_SESSION_TTL_DAYS=90
