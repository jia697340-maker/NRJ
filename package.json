    "test:wan": "tsx scripts/test-wan-video.ts",
    "test:seedance": "tsx scripts/test-seedance-video.ts",
    "test:h3": "tsx scripts/test-minimax-h3-video.ts",
    "test:agnes": "tsx scripts/test-agnes-video.ts",
    "test:atlas": "tsx scripts/test-atlas-cloud-video.ts",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit --incremental false"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
