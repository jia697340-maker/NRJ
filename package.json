    "test:reasoning": "tsx scripts/test-reasoning-adapters.ts",
    "test:doubao-tts": "tsx scripts/test-doubao-tts.ts",
    "test:fish-audio": "tsx scripts/test-fish-audio.ts",
    "test:mcp": "tsx scripts/test-mcp-adapters.ts",
    "test:reply-variants": "tsx scripts/test-reply-variants.ts",
    "test:forum": "tsx scripts/test-forum-policy.ts",
    "test:forum-runtime": "tsx scripts/test-forum-runtime.ts",
    "test:forum-generation": "tsx scripts/test-forum-generation.ts",
    "test:time": "tsx scripts/test-conversation-time.ts",
    "test:music-qr": "node scripts/test-music-qr.mjs",
