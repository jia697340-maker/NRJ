{
  "name": "-",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "music:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-music.ps1",
    "music:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local-music.ps1",
    "build": "vue-tsc -b && vite build",
    "check": "npm run typecheck && npm run lint && npm run test:desktop-layout && npm run test:widget-source && npm run test:mcp && npm run test:api-nodes && npm run test:wallet && npm run test:wallet-market && npm run test:transfer && npm run test:prompt && npm run test:group && npm run test:chat-assets && npm run test:reasoning && npm run test:doubao-tts && npm run test:fish-audio && npm run test:veo && npm run test:omni && npm run test:kling && npm run test:wan && npm run test:seedance && npm run test:h3 && npm run test:agnes && npm run test:atlas && npm run test:reply-variants && npm run test:forum && npm run test:forum-runtime && npm run test:forum-generation && npm run build",
    "lint": "eslint src scripts vite.config.ts --max-warnings 0",
    "preview": "vite preview",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "test:api-nodes": "tsx scripts/test-api-nodes.ts",
    "test:desktop-layout": "tsx scripts/test-desktop-layout.ts",
    "test:widget-source": "tsx scripts/test-widget-source-runtime.ts",
