FROM golang:1.26-alpine AS music-api-builder

RUN apk add --no-cache git
ARG MUSIC_API_REF=bacdfbe6cf6a5ba7331463d2039e3aac915c627f
RUN git clone https://github.com/guohuiyuan/go-music-api.git /src/go-music-api \
    && cd /src/go-music-api \
    && git checkout "$MUSIC_API_REF" \
    && awk '{ print } /"fmt"/ { print "\t\"os\"" }' main.go > main.go.tmp \
    && mv main.go.tmp main.go \
    && sed -i 's#r.Run(":8080")#r.Run(":" + os.Getenv("MUSIC_API_PORT"))#' main.go
WORKDIR /src/go-music-api
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/go-music-api .

FROM node:24-alpine

WORKDIR /app
COPY --from=music-api-builder /out/go-music-api /usr/local/bin/go-music-api
COPY music-gateway/package.json ./music-gateway/package.json
COPY music-gateway/src ./music-gateway/src
COPY deployment/start-northflank-music.sh /usr/local/bin/start-northflank-music

RUN chmod +x /usr/local/bin/start-northflank-music \
    && mkdir -p /data /tmp/music-public /tmp/music-auth

ENV PORT=8787
ENV MUSIC_DATA_DIR=/data
ENV MUSIC_PUBLIC_UPSTREAM=http://127.0.0.1:8081
ENV MUSIC_AUTH_UPSTREAM=http://127.0.0.1:8082
ENV MUSIC_COOKIE_SECURE=true
ENV MUSIC_COOKIE_SAME_SITE=None
ENV MUSIC_SESSION_TTL_DAYS=90

EXPOSE 8787
CMD ["/usr/local/bin/start-northflank-music"]
